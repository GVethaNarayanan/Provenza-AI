# Provenza AI - Environment Variables
# ====================================

# LLM API Keys (at least one required for live mode)
GEMINI_API_KEY=
OPENAI_API_KEY=

# MongoDB (future - not required for MVP)
MONGODB_URI=

# AWS S3 (future - not required for MVP)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Vector DB (future - not required for MVP)
VECTOR_DB_URL=

# Application Settings
DEMO_MODE=true
LOG_LEVEL=INFO
